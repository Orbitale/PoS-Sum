{
	"name": "pos_sum",
	"version": "1.0.7",
	"description": "A lightweight point-of-sale application for desktop or mobile",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"tauri": "tauri",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"license": "MIT",
	"dependencies": {
		"@tauri-apps/api": "^2.12.5",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"@zerodevx/svelte-toast": "^0.9.6",
		"bootstrap": "^5.3.9"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tauri-apps/cli": "^2.12.6",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.13",
		"@types/bootstrap": "^5.2.11",
		"@types/node": "^26.6.10",
		"fake-indexeddb": "^6.2.8",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^3.2.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
